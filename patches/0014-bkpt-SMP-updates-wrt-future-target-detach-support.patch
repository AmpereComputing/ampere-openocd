+				if (retval != ERROR_OK)
+					return retval;
+				breakpoint_set = true;
+			}
+		}
+
+		if (!breakpoint_set) {
+			LOG_ERROR("Unable to set breakpoint. At least one SMP target must be examined.");
+			return ERROR_FAIL;
 		}
 
 		return ERROR_OK;
