From 54e01a18c018f807cd526bf051d226867488d3ab Mon Sep 17 00:00:00 2001
From: Steve Clevenger <scclevenger@os.amperecomputing.com>
Date: Mon, 10 Mar 2025 21:57:07 -0600
Subject: [PATCH 17/32] svf: treat zero MASK as special case for scandump

The svf command compares the actual TDO values scanned out of the
processor against the expected TDO values contained in the SVF file.
For scandump operations, the final expected TDO value isn't known prior
to the scan. As a result, for the last scan, the scan MASK value is set
to zero to instruct the debugger to bypass the bit compare.

The debugger only outputs the TDO data on a bit miscompare. With a mask
value of zero, the actual vs expected TDO compare is ignored and the
actual TDO data is not displayed to the user. This isn't useful because
for scandump operations, the user is interested in the final TDO value.

To work around this issue, force the debugger to output the TDO data
when a zero mask is encountered in the SVF file.

Change-Id: I355a7f7542dc22b20685892249815ecd70d2bddd
Signed-off-by: Steve Clevenger <scclevenger@os.amperecomputing.com>
Signed-off-by: Daniel Goehring <dgoehrin@os.amperecomputing.com>
---
 src/svf/svf.c | 44 ++++++++++++++++++++++++++++++++------------
 1 file changed, 32 insertions(+), 12 deletions(-)

diff --git a/src/svf/svf.c b/src/svf/svf.c
index 7491ad651..a29912105 100644
--- a/src/svf/svf.c
+++ b/src/svf/svf.c
@@ -926,6 +926,23 @@ static int svf_copy_hexstring_to_binary(char *str, uint8_t **bin, int orig_bit_l
 	return ERROR_OK;
 }
 
+static bool is_zero_mask(const void *_mask, int size)
+{
+	const uint8_t *mask = _mask;
+	int i;
+
+	int nbytes = size / 8;
+
+	for (i = 0; i < nbytes; i++) {
+		if (mask[i])
+			return false;
+	}
+
+	unsigned int trailing = size % 8;
+
+	return (!trailing || (mask[nbytes] & ((1 << trailing) - 1)) == 0) ? true : false;
+}
+
 static int svf_check_tdo(void)
 {
 	int i, len, index_var;
@@ -933,19 +950,22 @@ static int svf_check_tdo(void)
 	for (i = 0; i < svf_check_tdo_para_index; i++) {
 		index_var = svf_check_tdo_para[i].buffer_offset;
 		len = svf_check_tdo_para[i].bit_len;
-		if ((svf_check_tdo_para[i].enabled)
-				&& !buf_eq_mask(&svf_tdi_buffer[index_var], &svf_tdo_buffer[index_var],
-				&svf_mask_buffer[index_var], len)) {
-			LOG_ERROR("tdo check error at line %d",
-				svf_check_tdo_para[i].line_num);
-			SVF_BUF_LOG(ERROR, &svf_tdi_buffer[index_var], len, "READ");
-			SVF_BUF_LOG(ERROR, &svf_tdo_buffer[index_var], len, "WANT");
-			SVF_BUF_LOG(ERROR, &svf_mask_buffer[index_var], len, "MASK");
-
-			if (svf_ignore_error == 0)
-				return ERROR_FAIL;
-			else
+		if (svf_check_tdo_para[i].enabled) {
+			if (is_zero_mask(&svf_mask_buffer[index_var], len)) {
+				SVF_BUF_LOG(USER, &svf_tdi_buffer[index_var], len, "READ");
+			} else if (!buf_eq_mask(&svf_tdi_buffer[index_var], &svf_tdo_buffer[index_var],
+						&svf_mask_buffer[index_var], len)) {
+				LOG_ERROR("tdo check error at line %d",
+						svf_check_tdo_para[i].line_num);
+				SVF_BUF_LOG(ERROR, &svf_tdi_buffer[index_var], len, "READ");
+				SVF_BUF_LOG(ERROR, &svf_tdo_buffer[index_var], len, "WANT");
+				SVF_BUF_LOG(ERROR, &svf_mask_buffer[index_var], len, "MASK");
+
+				if (svf_ignore_error == 0)
+					return ERROR_FAIL;
+
 				svf_ignore_error++;
+			}
 		}
 	}
 	svf_check_tdo_para_index = 0;
-- 
